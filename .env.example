# Set to true to make the scheduled run compose and log without sending
DRY_RUN=false

# ---------------------------------------------------------------------------
# Payroll ingestion (daily hours + OT report)
# ---------------------------------------------------------------------------

# IMAP credentials for the shared inbox the payroll report lands in.
# DELIBERATELY SEPARATE from GMAIL_USER / GMAIL_APP_PASSWORD (which are the
# send-only birthday credentials) so either can be rotated — or the payroll
# integration revoked — without breaking the other.
PAYROLL_IMAP_USER=info@sequoiafp.com
PAYROLL_IMAP_PASSWORD=your_gmail_app_password_for_info
PAYROLL_IMAP_HOST=imap.gmail.com

# The Gmail label the payroll filter applies. Note the SPACE, and note that
# Gmail label names are case-sensitive over IMAP. This is the only thing
# limiting what the integration can see inside a shared inbox, so it is an env
# var rather than a constant — it can be corrected without a redeploy.
PAYROLL_IMAP_LABEL=payroll import

# Validated in code as well as in the Gmail filter. A labelled message from any
# other sender is recorded and reported, never parsed.
PAYROLL_SENDER=no-reply@centralservers.com

# Where parse failures, missed deliveries and flagged batches are emailed.
# Sent through the existing GMAIL_USER / GMAIL_APP_PASSWORD nodemailer transport.
PAYROLL_ALERT_EMAIL=peter.stroble@sequoiafp.com

# The report arrives ~6:04 AM Pacific and the work date is derived from that
# timestamp, so this must be the payroll vendor's zone — not the mill's
# America/Boise clock used by the birthday notifier.
PAYROLL_TIME_ZONE=America/Los_Angeles

# Rolling search window, in days. Small enough that a run never walks the
# mailbox; large enough that a message missed on an earlier run is still found.
PAYROLL_LOOKBACK_DAYS=7

# Shared secret for the manual trigger at /api/payroll-email-test (optional —
# a valid sfp_session cookie is accepted too).
PAYROLL_TRIGGER_SECRET=your_random_trigger_secret

# Set to true to make the scheduled ingest parse and log without writing.
PAYROLL_DRY_RUN=false
